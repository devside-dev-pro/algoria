# === Serveur (Vercel + Railway) — SECRET ===
# TELEGRAM_BOT_TOKEN=                              # bot : login, DM, relances, alertes
# TELEGRAM_VIP_CHAT=-100...                        # canal VIP (cartes de gains, briefings)
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=mailto:...   # web push (npx web-push generate-vapid-keys)
# MEMBER_CREDS_KEY=                                # chiffrement AES des mots de passe MT5
# ANTHROPIC_API_KEY=                               # narration du desk + voix du cockpit (optionnel)
# ALGORIA_REPLY_MODEL=claude-haiku-4-5-20251001    # brouillons de réponse aux messages reçus par le bot (Vercel ; défaut Haiku)
# ALGORIA_BOT_AUTOREPLY=0                          # 1 = le bot répond seul aux questions simples (OFF depuis le 09/09/2026 : brouillon + boutons pour Mathieu seulement)
# ALGORIA_NUDGE_SINCE=2026-09-09T00:00:00Z         # (runner S2) seuls les inscrits à partir de cette date reçoivent les 4 relances (48 h, 7 j, 14 j, 30 j)
# STH_PARTNER_LICENSE=                             # aussi sur le runner S2 pour l'audit STH quotidien (07 h UTC) — sinon l'audit se tait
# ALGORIA_STH_AUTOREPAIR=0                         # 1 = l'audit rebranche seul les membres `live` orphelins (jamais les pending)
# VIP_SILENT=0                                     # 1 (Railway, les 3 runners) = plus AUCUN post automatique dans le canal VIP (bloc A, 09/09/2026)
# ALGORIA_COPY_OBSERVE=1                           # (Railway, le runner du compte suivi) ce compte reçoit ses trades d'un copieur
#                                                  #   externe : on enregistre les positions apparues sans nous et les clôtures de
#                                                  #   TOUS les symboles. Sans ça : rien dans l'app, et des cartes de gain fausses.
#                                                  #   À poser sur le SEUL runner du compte relais, sinon l'historique est compté en double.
# ALGORIA_TRACK_SINCE=2026-09-09T00:00:00Z         # (Vercel) l'app membre et la landing n'affichent aucun trade clôturé avant cette date

